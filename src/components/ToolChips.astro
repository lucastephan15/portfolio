---
// Chips de ferramenta (stack) no estilo HUD da Nekobit.
import { TOOLS } from "../data/cases";
import { isDarkIcon } from "../lib/iconTone";

interface Props {
  tools?: string[];
}
const { tools = [] } = Astro.props;
const items = tools.map((t) => TOOLS[t]).filter(Boolean);
---

{
  items.length > 0 && (
    <div class="chips">
      {items.map((meta) => (
        <span class="chip font-mono">
          {meta.icon && (
            <img
              src={`/images/icons/${meta.icon}.svg`}
              alt=""
              width="14"
              height="14"
              loading="lazy"
              class:list={{ "icon-light": isDarkIcon(meta.icon) }}
            />
          )}
          {meta.name}
        </span>
      ))}
    </div>
  )
}

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    font-size: 11px;
    color: #d9d2f5;
    background: var(--color-fliperama);
    box-shadow: inset 0 0 0 2px var(--color-grade);
  }
  .chip img {
    width: 14px;
    height: 14px;
  }
  /* Ícone preto/escuro vira branco no fundo escuro */
  .icon-light {
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }
</style>
