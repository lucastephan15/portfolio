<script>
  // Inventário de serviços: abas (uma selecionada por vez) com setas ↑↓.
  document.querySelectorAll<HTMLElement>("[data-inv]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    const show = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute("aria-selected", j === i ? "true" : "false");
        t.tabIndex = j === i ? 0 : -1;
      });
      panels.forEach((p) => (p.hidden = p.dataset.panel !== tabs[i].dataset.tab));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => show(i));
      t.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
        e.preventDefault();
        show((i + (e.key === "ArrowDown" ? 1 : -1) + tabs.length) % tabs.length, true);
      });
    });
  });
</script>
