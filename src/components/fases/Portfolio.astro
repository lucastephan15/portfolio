---
// Fase "Portfólio": destaques (galeria) + Corporativo (grade), com filtro por
// stack e modal de case. Mesma lógica do site anterior; pele arcade Nekobit.
import HudHeading from "../nekobit/HudHeading.astro";
import ToolChips from "../ToolChips.astro";
import { cases, highlightCases, corporativoCompact, TOOLS } from "../../data/cases";
import { diagrams } from "../../data/diagrams";
import { isDarkIcon } from "../../lib/iconTone";

// Ferramentas para a barra de filtro (todas que aparecem, mais usadas primeiro).
const toolCounts = new Map<string, number>();
for (const c of cases) for (const t of c.tools) toolCounts.set(t, (toolCounts.get(t) || 0) + 1);
const filterTools = [...toolCounts.entries()]
  .map(([slug, count]) => ({ slug, count, name: TOOLS[slug]?.name, icon: TOOLS[slug]?.icon }))
  .filter((t) => t.name)
  .sort((a, b) => b.count - a.count)
  .slice(0, 20); // barra enxuta: as 20 ferramentas mais recorrentes
---

<div class="p-wrap">
  <!-- ── Abertura da fase ── -->
  <header class="p-intro">
    <a href="#menu" class="p-menu-link font-pixel">◀ Menu</a>
    <div class="p-title-row">
      <img src="/images/nekobit/trofeu-portfolio.webp" alt="" width="72" height="72" class="p-trophy" />
      <div>
        <p class="p-kicker font-mono">02 · Portfólio</p>
        <h2 class="p-title font-pixel">Portfólio</h2>
        <p class="p-sub">Trabalhos em destaque e corporativos.</p>
      </div>
    </div>
  </header>

  <div id="trabalhos">
    <!-- ── Filtro por ferramenta ── -->
    <div class="p-filter" data-filterbar>
      <span class="p-filter-label font-mono">Filtrar por stack</span>
      {
        filterTools.map((t) => (
          <button type="button" data-filter={t.slug} class="filter-chip font-mono">
            {t.icon && (
              <img
                src={`/images/icons/${t.icon}.svg`}
                alt=""
                width="14"
                height="14"
                class:list={{ "icon-light": isDarkIcon(t.icon) }}
              />
            )}
            {t.name}
          </button>
        ))
      }
      <button type="button" data-filter-clear hidden class="filter-clear font-mono">✕ Limpar</button>
    </div>

    <!-- ── 01 · Em destaque — galeria horizontal ── -->
    <div data-group data-gallery-root class="p-group">
      <div class="p-group-head">
        <HudHeading num="01" title="Em destaque" />
        <div class="p-gallery-nav">
          <span class="p-hint font-mono">Arraste para o lado</span>
          <button type="button" data-gallery-prev aria-label="Anterior" class="p-nav-btn font-pixel">‹</button>
          <button type="button" data-gallery-next aria-label="Próximo" class="p-nav-btn font-pixel">›</button>
        </div>
      </div>

      <div data-gallery class="gallery p-gallery">
        {
          highlightCases.map((c) => (
            <article data-card data-tools={c.tools.join(" ")} class="p-card notch">
              {/* Preview: screenshot, diagrama ou capa tipográfica */}
              <div class="p-preview">
                {c.preview ? (
                  <img
                    src={`/images/previews/${c.preview}.webp`}
                    alt={`Prévia de ${c.title}`}
                    width="960"
                    height="600"
                    loading="lazy"
                    class="p-shot"
                  />
                ) : c.diagram && diagrams[c.diagram] ? (
                  <div class="diagram-preview p-diagram">
                    <Fragment set:html={diagrams[c.diagram]} />
                  </div>
                ) : (
                  <div class="p-cover">
                    <span class="p-cover-rule bg-neon" />
                    <p class="p-cover-title">{c.coverTitle ?? c.summary}</p>
                    <p class="p-cover-meta font-mono">{c.coverMeta ?? c.stack}</p>
                  </div>
                )}
                <div class="p-fade" />
                {c.badge && <span class="p-badge font-mono">{c.badge}</span>}
                {c.video && (
                  <button type="button" data-open={c.slug} aria-label={`Assistir: ${c.title}`} class="p-play">
                    <span class="font-pixel">▶</span>
                  </button>
                )}
                {c.soon && <span class="p-soon font-mono">Em breve</span>}
              </div>

              {/* Corpo */}
              <div class="p-body">
                <div class="p-meta font-mono">
                  {c.date && <span>{c.date}</span>}
                  <span class="p-cat">{c.category}</span>
                </div>
                <h3 class="p-card-title font-pixel">
                  {c.link ? (
                    <a href={c.link} target="_blank" rel="noopener noreferrer" class="p-stretch">
                      {c.title}
                    </a>
                  ) : (
                    c.title
                  )}
                </h3>
                <p class="p-summary">{c.summary}</p>
                {c.impact && <p class="p-impact">↳ {c.impact}</p>}
                <div class="p-chips">
                  <ToolChips tools={c.tools} />
                </div>

                <div class="p-actions">
                  {c.link && (
                    <a href={c.link} target="_blank" rel="noopener noreferrer" class="p-act p-act-main font-pixel">
                      {c.linkLabel ?? "Abrir"} ↗
                    </a>
                  )}
                  {c.repo && (
                    <a href={c.repo} target="_blank" rel="noopener noreferrer" class="p-act font-pixel">
                      <img src="/images/icons/github.svg" alt="" width="14" height="14" loading="lazy" class="icon-light" />
                      Código
                    </a>
                  )}
                  {(c.detail || c.diagram || c.video) && (
                    <button type="button" data-open={c.slug} class:list={["p-act font-pixel", { "p-act-main": !c.link }]}>
                      {c.video ? "Assistir" : c.diagram ? "Ver arquitetura" : "Detalhes"} ›
                    </button>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <!-- ── 02 · Corporativo — grade compacta ── -->
    <div data-group class="p-group">
      <HudHeading num="02" title="Corporativo" />
      <div class="p-corp-note">
        <span class="p-prev font-mono">Experiência anterior</span>
        <p>Automações, agentes e dados em produção de experiências anteriores à Nekobit — clientes e nomes omitidos por NDA.</p>
      </div>
      <ul class="p-corp">
        {
          corporativoCompact.map((c) => (
            <li data-card data-tools={c.tools.join(" ")}>
              <button type="button" data-open={c.slug} class="p-corp-card notch">
                <span class="p-cat font-mono">{c.category}</span>
                <span class="p-corp-title font-pixel">{c.title}</span>
                <span class="p-summary">{c.summary}</span>
                <span class="p-chips">
                  <ToolChips tools={c.tools} />
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <p data-empty hidden class="p-empty">
      Nenhum trabalho com esse filtro.
      <button type="button" data-filter-clear class="filter-clear font-mono">✕ Limpar filtros</button>
    </p>
  </div>

  <div class="p-end">
    <a href="#menu" class="btn-px">▲ Voltar ao menu</a>
  </div>
</div>

<!-- Fontes ocultas do modal (uma por case) -->
<div id="case-sources" hidden>
  {
    cases.map((c) => (
      <article data-modal={c.slug}>
        {c.video && (
          <video
            controls
            playsinline
            preload="none"
            poster={`/images/previews/${c.video}-poster.webp`}
            class="m-video"
          >
            <source src={`/videos/${c.video}.mp4`} type="video/mp4" />
          </video>
        )}
        <p class="m-cat font-mono">
          {c.category}
          {c.group === "corporativo" && !c.highlight && <span class="p-prev">Experiência anterior</span>}
        </p>
        <h3 class="m-title font-pixel">{c.title}</h3>
        <p class="m-text">{c.detail ?? c.summary}</p>
        {c.impact && (
          <p class="m-impact notch">
            <b>Impacto.</b> {c.impact}
          </p>
        )}
        {c.diagram && diagrams[c.diagram] && (
          <div class="m-block">
            <p class="m-label font-mono">Arquitetura</p>
            <div class="m-diagram notch">
              <Fragment set:html={diagrams[c.diagram]} />
            </div>
          </div>
        )}
        {c.stack && (
          <p class="m-stack">
            <span class="m-label font-mono">Stack</span> · {c.stack}
          </p>
        )}
        <div class="m-chips">
          <ToolChips tools={c.tools} />
        </div>
        {(c.link || c.repo) && (
          <div class="m-links">
            {c.link && (
              <a href={c.link} target="_blank" rel="noopener noreferrer" class="btn-px">
                {c.linkLabel ?? "Abrir"} ↗
              </a>
            )}
            {c.repo && (
              <a href={c.repo} target="_blank" rel="noopener noreferrer" class="btn-px ghost">
                Código
              </a>
            )}
          </div>
        )}
      </article>
    ))
  }
</div>

<!-- Marcador de seta compartilhado p/ os diagramas -->
<svg width="0" height="0" aria-hidden="true" style="position:absolute">
  <defs>
    <marker id="dgArrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#6d76ff"></path>
    </marker>
  </defs>
</svg>

<!-- Modal de case -->
<div id="case-modal" class="m-modal" aria-hidden="true" hidden>
  <div data-backdrop class="m-backdrop"></div>
  <div role="dialog" aria-modal="true" aria-label="Detalhes do trabalho" class="m-dialog notch">
    <button type="button" data-close aria-label="Fechar" class="m-close font-pixel">✕</button>
    <div id="case-modal-body"></div>
  </div>
</div>

<style>
  .p-wrap {
    max-width: 1152px;
    margin: 0 auto;
    padding: 24px 24px 96px;
  }
  @media (min-width: 768px) {
    .p-wrap { padding: 24px 40px 112px; }
  }

  /* ── Abertura ── */
  .p-intro { padding-bottom: 56px; }
  .p-menu-link {
    display: inline-block;
    padding: 8px 0;
    font-size: 22px;
    color: var(--color-ficha);
    text-decoration: none;
  }
  .p-title-row {
    margin-top: 40px;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .p-trophy {
    width: 144px;
    height: 144px;
    image-rendering: pixelated;
    flex: none;
  }
  .p-kicker {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ciano);
  }
  .p-title {
    margin: 4px 0;
    font-size: clamp(48px, 9vw, 88px);
    font-weight: 400;
    line-height: 1;
  }
  .p-sub { margin: 0; color: #d9d2f5; }
  @media (max-width: 520px) {
    .p-title-row { gap: 16px; margin-top: 24px; }
    .p-trophy { width: 72px; height: 72px; }
  }

  /* ── Filtro ── */
  .p-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 64px;
  }
  /* Celular: filtro numa linha só, com rolagem lateral */
  @media (max-width: 640px) {
    .p-filter {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin: 0 -24px 48px;
      padding: 0 24px 10px;
      scrollbar-width: none;
    }
    .p-filter > * { flex: none; }
  }
  .p-filter-label {
    margin-right: 6px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-nevoa);
  }
  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    font-size: 12px;
    color: #d9d2f5;
    background: var(--color-fliperama);
    border: 0;
    box-shadow: inset 0 0 0 2px var(--color-grade);
    cursor: pointer;
  }
  .filter-chip:hover { box-shadow: inset 0 0 0 2px var(--color-ciano); }
  .filter-chip:focus-visible { outline: 2px solid var(--color-ficha); outline-offset: 2px; }
  .filter-chip img { width: 14px; height: 14px; }
  /* Ativo: chip aceso em ciano; ícone volta à cor original (fundo claro) */
  .filter-chip:global(.is-active) {
    background: var(--color-ciano);
    color: var(--color-fliperama);
    box-shadow: none;
  }
  .filter-chip:global(.is-active) img { filter: none; opacity: 1; }
  .filter-clear {
    padding: 5px 10px;
    font-size: 12px;
    color: var(--color-rosa);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .icon-light { filter: brightness(0) invert(1); opacity: 0.9; }

  /* ── Grupos ── */
  .p-group + .p-group { margin-top: 96px; }
  .p-group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 24px;
  }
  .p-group-head > :global(.hud) { flex: 1; min-width: 260px; }
  .p-gallery-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 40px;
  }
  .p-hint {
    margin-right: 6px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-nevoa);
  }
  @media (max-width: 640px) {
    .p-hint { display: none; }
    .p-gallery-nav { margin: -24px 0 24px auto; }
  }
  .p-nav-btn {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    font-size: 28px;
    line-height: 1;
    color: var(--color-fosforo);
    background: var(--color-fliperama);
    border: 0;
    box-shadow: inset 0 0 0 2px var(--color-grade);
    cursor: pointer;
  }
  .p-nav-btn:hover:not(:disabled) { color: var(--color-ciano); box-shadow: inset 0 0 0 2px var(--color-ciano); }
  .p-nav-btn:disabled { opacity: 0.3; cursor: default; }

  /* ── Galeria ── */
  .p-gallery {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin: 0 -24px;
    padding: 0 24px 16px;
    scrollbar-color: var(--color-grade) transparent;
  }
  @media (min-width: 768px) {
    .p-gallery { margin: 0; padding: 0 0 16px; }
  }
  .p-card {
    position: relative;
    flex: none;
    width: min(84vw, 400px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: var(--color-tela);
    box-shadow: inset 0 0 0 2px var(--color-grade);
  }
  .p-card:hover { box-shadow: inset 0 0 0 2px var(--color-rosa); }
  .p-card:global(.hidden) { display: none; }
  .p-preview {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    margin: 2px 2px 0;
    background: var(--color-fliperama);
  }
  .p-shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .p-diagram {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 8px;
  }
  .p-cover {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    padding: 0 32px;
  }
  .p-cover-rule { width: 48px; height: 4px; }
  .p-cover-title { margin: 0; font-size: 17px; line-height: 1.4; color: var(--color-fosforo); }
  .p-cover-meta { margin: 0; font-size: 11px; line-height: 1.5; color: var(--color-nevoa); }
  .p-fade {
    pointer-events: none;
    position: absolute;
    inset: auto 0 0 0;
    height: 64px;
    background: linear-gradient(to top, var(--color-tela), transparent);
  }
  .p-badge,
  .p-soon {
    position: absolute;
    top: 14px;
    padding: 3px 8px;
    font-size: 11px;
    letter-spacing: 0.06em;
  }
  .p-badge { left: 14px; color: var(--color-fosforo); background: var(--color-fliperama); box-shadow: inset 0 0 0 2px var(--color-grade); }
  .p-soon { right: 14px; color: var(--color-fliperama); background: var(--color-ficha); }
  .p-play {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .p-play span {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    padding-left: 4px;
    font-size: 28px;
    color: var(--color-fliperama);
    background: var(--color-rosa);
    box-shadow: 4px 4px 0 var(--color-anil);
  }
  .p-play:hover span { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--color-anil); }
  .p-play:focus-visible span { outline: 2px solid var(--color-ficha); outline-offset: 4px; }

  .p-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 20px 24px 24px;
  }
  .p-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-nevoa);
  }
  .p-cat { text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-ciano); font-size: 11px; }
  .p-card-title {
    margin: 10px 0 0;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.05;
    color: var(--color-fosforo);
  }
  .p-card-title a { color: inherit; text-decoration: none; }
  .p-card:hover .p-card-title { color: var(--color-ciano); }
  /* Card inteiro clicável quando há link (por trás das ações) */
  .p-stretch::before { content: ""; position: absolute; inset: 0; }
  .p-summary { margin: 10px 0 0; font-size: 14px; line-height: 1.6; color: #d9d2f5; }
  .p-impact { margin: 10px 0 0; font-size: 13px; color: var(--color-ficha); }
  .p-chips { display: block; margin-top: 16px; }
  .p-actions {
    position: relative;
    z-index: 3;
    margin-top: auto;
    padding-top: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 20px;
  }
  .p-act {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 0;
    font-size: 20px;
    color: #d9d2f5;
    text-decoration: none;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .p-act:hover { color: var(--color-ciano); }
  .p-act-main { color: var(--color-ficha); }
  .p-act img { width: 14px; height: 14px; }

  /* ── Corporativo ── */
  .p-corp-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin: -16px 0 28px;
  }
  .p-corp-note p { margin: 0; font-size: 14px; color: var(--color-nevoa); }
  .p-prev {
    display: inline-block;
    padding: 3px 8px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ficha);
    box-shadow: inset 0 0 0 2px var(--color-ficha);
  }
  .p-corp {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  @media (min-width: 640px) { .p-corp { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .p-corp { grid-template-columns: repeat(3, 1fr); } }
  .p-corp li { height: 100%; }
  .p-corp li:global(.hidden) { display: none; }
  .p-corp-card {
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 20px;
    text-align: left;
    color: inherit;
    font: inherit;
    background: var(--color-tela);
    border: 0;
    box-shadow: inset 0 0 0 2px var(--color-grade);
    cursor: pointer;
  }
  .p-corp-card:hover,
  .p-corp-card:focus-visible { box-shadow: inset 0 0 0 2px var(--color-ciano); outline: none; }
  .p-corp-title { margin-top: 8px; font-size: 22px; line-height: 1.1; color: var(--color-fosforo); }
  .p-corp-card:hover .p-corp-title { color: var(--color-ciano); }

  .p-group:global(.hidden) { display: none; }
  .p-empty { margin-top: 40px; color: var(--color-nevoa); font-size: 14px; }
  .p-end {
    margin-top: 96px;
    padding-top: 40px;
    border-top: 2px solid var(--color-grade);
  }

  /* ── Modal ── */
  .m-modal {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .m-modal[hidden] { display: none; }
  .m-backdrop { position: absolute; inset: 0; background: rgba(13, 10, 31, 0.85); }
  .m-dialog {
    position: relative;
    width: 100%;
    max-width: 768px;
    max-height: 88vh;
    overflow-y: auto;
    padding: 40px 24px 32px;
    background: var(--color-tela);
    box-shadow: inset 0 0 0 2px var(--color-grade);
  }
  @media (min-width: 768px) { .m-dialog { padding: 48px 40px 40px; } }
  .m-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    font-size: 22px;
    color: var(--color-fosforo);
    background: var(--color-fliperama);
    border: 0;
    box-shadow: inset 0 0 0 2px var(--color-grade);
    cursor: pointer;
  }
  .m-close:hover { color: var(--color-rosa); box-shadow: inset 0 0 0 2px var(--color-rosa); }
  .m-close:focus { outline: none; }
  .m-close:focus-visible { box-shadow: inset 0 0 0 2px var(--color-ficha); }
  .m-video { display: block; width: 100%; aspect-ratio: 16 / 9; margin-bottom: 28px; background: var(--color-fliperama); }
  .m-cat {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ciano);
  }
  .m-title { margin: 10px 0 0; font-size: clamp(30px, 4.5vw, 40px); font-weight: 400; line-height: 1.05; }
  .m-text { margin: 16px 0 0; line-height: 1.7; color: #d9d2f5; }
  .m-impact { margin: 20px 0 0; padding: 14px 16px; font-size: 14px; line-height: 1.6; background: var(--color-fliperama); color: #d9d2f5; }
  .m-impact b { color: var(--color-ficha); }
  .m-block { margin-top: 28px; }
  .m-label { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ciano); }
  .m-block .m-label { display: block; margin: 0 0 10px; }
  .m-diagram { overflow-x: auto; padding: 16px; background: var(--color-fliperama); }
  .m-stack { margin: 24px 0 0; font-size: 13px; line-height: 1.6; color: var(--color-nevoa); }
  .m-chips { margin-top: 14px; }
  .m-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 28px;
    padding-top: 24px;
    border-top: 2px solid var(--color-grade);
  }
</style>

<script>
  // Modal de cases — clona a fonte oculta correspondente ao slug.
  const modal = document.getElementById("case-modal");
  const body = document.getElementById("case-modal-body");
  const sources = document.getElementById("case-sources");

  if (modal && body && sources) {
    let lastFocus: HTMLElement | null = null;

    const open = (slug: string, trigger: HTMLElement) => {
      const src = sources.querySelector(`[data-modal="${slug}"]`);
      if (!src) return;
      lastFocus = trigger;
      body.innerHTML = src.innerHTML;
      modal.hidden = false;
      modal.setAttribute("aria-hidden", "false");
      (modal.querySelector(".m-dialog") as HTMLElement).scrollTop = 0;
      document.body.style.overflow = "hidden";
      (modal.querySelector("[data-close]") as HTMLElement | null)?.focus();
      // Vídeo só começa sozinho se a pessoa não pediu menos movimento.
      const video = body.querySelector("video");
      if (video && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        video.play().catch(() => {});
      }
    };

    const close = () => {
      if (modal.hidden) return;
      modal.hidden = true;
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      body.innerHTML = "";
      lastFocus?.focus({ preventScroll: true });
    };

    document.querySelectorAll<HTMLElement>("[data-open]").forEach((el) => {
      el.addEventListener("click", () => open(el.getAttribute("data-open") || "", el));
    });
    modal.querySelector("[data-backdrop]")?.addEventListener("click", close);
    modal.querySelector("[data-close]")?.addEventListener("click", close);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
    // Trocou de fase (hash) com o modal aberto: fecha.
    window.addEventListener("hashchange", close);
  }

  // Galeria horizontal dos destaques: setas rolam de um card por vez e
  // se desabilitam nas pontas.
  const groot = document.querySelector<HTMLElement>("[data-gallery-root]");
  const rail = groot?.querySelector<HTMLElement>("[data-gallery]");
  const prev = groot?.querySelector<HTMLButtonElement>("[data-gallery-prev]");
  const next = groot?.querySelector<HTMLButtonElement>("[data-gallery-next]");

  if (rail && prev && next) {
    const step = () => {
      const card = rail.querySelector<HTMLElement>("[data-card]:not(.hidden)");
      const gap = parseFloat(getComputedStyle(rail).columnGap || "24") || 24;
      return card ? card.offsetWidth + gap : rail.clientWidth * 0.8;
    };
    const sync = () => {
      const max = rail.scrollWidth - rail.clientWidth - 2;
      prev.disabled = rail.scrollLeft <= 2;
      next.disabled = rail.scrollLeft >= max;
    };
    const behavior = matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth";
    prev.addEventListener("click", () => rail.scrollBy({ left: -step(), behavior }));
    next.addEventListener("click", () => rail.scrollBy({ left: step(), behavior }));
    rail.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);
    // A fase começa trancada (hidden): as medidas só existem quando ela abre.
    new ResizeObserver(sync).observe(rail);
    sync();

    // Filtrar muda a largura do trilho: reavalia as setas no próximo frame.
    document
      .querySelectorAll<HTMLElement>("[data-filter], [data-filter-clear]")
      .forEach((el) => el.addEventListener("click", () => requestAnimationFrame(sync)));
  }

  // Filtro de trabalhos por ferramenta (stack). Multi-seleção, semântica OU.
  const section = document.getElementById("trabalhos");
  if (section) {
    const chips = Array.from(section.querySelectorAll<HTMLElement>("[data-filter]"));
    const cards = Array.from(section.querySelectorAll<HTMLElement>("[data-card]"));
    const groups = Array.from(section.querySelectorAll<HTMLElement>("[data-group]"));
    const clears = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-filter-clear]"));
    const empty = section.querySelector<HTMLElement>("[data-empty]");
    const active = new Set<string>();

    const apply = () => {
      let anyVisible = false;
      cards.forEach((card) => {
        const tools = (card.getAttribute("data-tools") || "").split(" ");
        const show = active.size === 0 || [...active].some((a) => tools.includes(a));
        card.classList.toggle("hidden", !show);
        if (show) anyVisible = true;
      });
      groups.forEach((g) => g.classList.toggle("hidden", !g.querySelector("[data-card]:not(.hidden)")));
      chips.forEach((ch) => {
        const on = active.has(ch.getAttribute("data-filter") || "");
        ch.classList.toggle("is-active", on);
        ch.setAttribute("aria-pressed", on ? "true" : "false");
      });
      clears.forEach((c) => (c.hidden = active.size === 0));
      if (empty) empty.hidden = anyVisible;
    };

    chips.forEach((ch) =>
      ch.addEventListener("click", () => {
        const slug = ch.getAttribute("data-filter") || "";
        if (active.has(slug)) active.delete(slug);
        else active.add(slug);
        apply();
      }),
    );
    clears.forEach((c) =>
      c.addEventListener("click", () => {
        active.clear();
        apply();
      }),
    );
    apply();
  }
</script>
