---
// Céu de estrelas em pixel. Semente fixa: o mesmo céu em todo build.
import { PALETTE } from "../../lib/pixel";

interface Props {
  count?: number;
  seed?: number;
}
const { count = 140, seed = 7 } = Astro.props;

let s = seed;
const rnd = () => (s = (s * 16807) % 2147483647) / 2147483647;
const W = 400;
const H = 240;
const colors = [PALETTE.fosforo, PALETTE.fosforo, PALETTE.ciano, PALETTE.rosa, PALETTE.violeta];
const stars = Array.from({ length: count }, (_, i) => ({
  x: Math.floor(rnd() * W),
  y: Math.floor(rnd() * H * 0.7),
  fill: colors[Math.floor(rnd() * colors.length)],
  opacity: (0.3 + rnd() * 0.7).toFixed(2),
  twinkle: i % 9 === 0, // ~1 em 9 cintila
}));
---

<svg
  class="starfield"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  {
    stars.map((st, i) => (
      <rect
        x={st.x}
        y={st.y}
        width="1"
        height="1"
        fill={st.fill}
        opacity={st.opacity}
        class={st.twinkle ? "twinkle" : undefined}
        style={st.twinkle ? `animation-delay:${(i % 7) * 0.6}s` : undefined}
      />
    ))
  }
</svg>
