---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  image?: string; // imagem de compartilhamento (1200×630), caminho em /public
}

const {
  title = "Nekobit — Luca Stephan",
  description = "Portfólio de Luca Stephan: apps, ferramentas e pesquisa na fronteira entre software, dados e IA.",
  bodyClass,
  image = "/og.png",
} = Astro.props;

// URLs absolutas para os previews de link (WhatsApp, LinkedIn, X…)
const site = Astro.site ?? new URL("https://nekobit.com.br");
const pageUrl = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={pageUrl} />

    <!-- Preview de link (Open Graph + X/Twitter) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nekobit" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo da Nekobit em pixel art: software sob encomenda — sistemas de IA, agentes e automações." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#0d0a1f" />

    <!-- Fontes: Jersey 15 (títulos pixel) + Inter (texto) + JetBrains Mono (rótulos) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Jersey+15&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
