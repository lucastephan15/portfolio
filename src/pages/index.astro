---
// Tela inicial (capa arcade). PRESS START abre o menu com as fases.
// /#menu abre direto no menu (é para onde os botões "◀ Menu" voltam).
import Layout from "../layouts/Layout.astro";
import Logo from "../components/nekobit/Logo.astro";
import Starfield from "../components/nekobit/Starfield.astro";
import MenuBar from "../components/nekobit/MenuBar.astro";
import PixelSprite from "../components/nekobit/PixelSprite.astro";
import Jogador from "../components/fases/Jogador.astro";
import Portfolio from "../components/fases/Portfolio.astro";
import Nekobit from "../components/fases/Nekobit.astro";
import { SYMBOL, steps } from "../lib/pixel";

const phases = [
  {
    id: "jogador",
    label: "Jogador",
    sub: "Luca Stephan — trajetória, sobre e contato",
    portrait: "/images/nekobit/retrato-jogador.webp",
  },
  {
    id: "portfolio",
    label: "Portfólio",
    sub: "Trabalhos em destaque e corporativos",
    portrait: "/images/nekobit/trofeu-portfolio.webp",
  },
  {
    id: "nekobit",
    label: "Nekobit",
    kicker: "Sobre a Nekobit",
    sub: "O que fazemos e como trabalhamos",
    icon: { grid: SYMBOL, color: steps(6), w: 7, h: 6 },
  },
];
---

<Layout
  title="Nekobit — sistemas de IA e automações sob medida"
  description="Nekobit: sistemas de IA, automações e produtos de dados sob medida. Portfólio de Luca Stephan."
  bodyClass="bg-fliperama text-fosforo"
>
  <main id="cover" class="cover scanlines" data-state="start">
    <Starfield />
    <div class="grid-floor" aria-hidden="true"></div>

    <div class="cover-inner">
      <h1 class="sr-only">Nekobit</h1>
      <div class="cover-logo">
        <Logo blink />
      </div>

      <button id="press-start" type="button" class="press-start font-pixel">
        <span class="blink-step" aria-hidden="true">▶</span> PRESS START
      </button>

      <nav id="menu" class="menu" aria-label="Menu principal" hidden>
        {
          phases.map((p, i) => (
            <MenuBar
              href={`#${p.id}`}
              kicker={`0${i + 1} · ${p.kicker ?? p.label}`}
              title={p.label}
              sub={p.sub}
              portrait={p.portrait}
              selected={i === 0}
            >
              {p.icon && (
                <PixelSprite slot="icon" layers={[{ grid: p.icon.grid, color: p.icon.color }]} width={p.icon.w} height={p.icon.h} />
              )}
            </MenuBar>
          ))
        }
      </nav>
    </div>
  </main>

  <!-- Fases: trancadas (hidden) até a barra correspondente ser escolhida.
       Qualquer âncora dentro de uma fase (#contato, #trabalhos…) destrava a fase. -->
  {
    phases.map((p) => (
      <section id={p.id} data-phase={p.id} class="phase" hidden>
        {p.id === "jogador" && <Jogador />}
        {p.id === "portfolio" && <Portfolio />}
        {p.id === "nekobit" && <Nekobit />}
      </section>
    ))
  }

  <!-- Transição ao entrar numa fase: tela "carregando fase" (~0,6 s, em passos) -->
  <div id="fx" class="fx" aria-hidden="true" hidden>
    <div class="fx-load">
      <p class="fx-load-k font-mono">Carregando fase</p>
      <p class="fx-load-name font-pixel" data-fx-name></p>
      <div class="fx-load-bar notch"><span></span></div>
    </div>
  </div>
</Layout>

<style>
  .cover {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  .cover-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    padding: 0 16px;
  }
  /* Logo em múltiplos inteiros de pixel: 41 bits × --u */
  .cover-logo {
    --u: 7px;
    filter: drop-shadow(0 0 18px rgba(255, 95, 162, 0.45)) drop-shadow(0 0 40px rgba(56, 214, 255, 0.25));
  }
  @media (min-width: 480px) { .cover-logo { --u: 10px; } }
  @media (min-width: 1024px) { .cover-logo { --u: 13px; } }
  @media (min-width: 1280px) { .cover-logo { --u: 16px; } }
  /* Onde houver round(): maior pixel inteiro que cabe na tela (41 bits + margens) */
  @supports (width: round(down, 10px, 1px)) {
    .cover-logo { --u: round(down, min(16px, (100vw - 40px) / 41), 1px); }
  }

  .press-start {
    background: none;
    border: 0;
    color: var(--color-ficha);
    font-size: 20px;
    letter-spacing: 0.2em;
    padding: 14px 20px; /* alvo de toque confortável */
    cursor: pointer;
  }
  .press-start:focus-visible {
    outline: 2px solid var(--color-ficha);
    outline-offset: 4px;
  }
  @media (min-width: 1024px) {
    .press-start { font-size: 22px; }
  }

  /* Ao apertar: pisca rápido 3 vezes antes de abrir o menu */
  .cover[data-state="starting"] .press-start {
    animation: press 0.6s steps(1) 1;
  }
  @keyframes press {
    0%, 34%, 68% { opacity: 1; }
    17%, 51%, 85% { opacity: 0; }
  }
  .cover[data-state="menu"] .press-start {
    display: none;
  }

  .menu {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: min(600px, 100%);
    --u: 6px; /* ícones 7×7 → 42px dentro do quadro de 72px */
  }
  .cover-inner:has(.menu:not([hidden])) {
    gap: 40px;
  }

  /* Fase destravada (conteúdo provisório até as fases 3–5) */
  .phase {
    border-top: 2px solid var(--color-grade);
  }
  /* ── Transição de entrada nas fases ── */
  .fx {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: all;
  }
  .fx[hidden] { display: none; }
  /* Tela "carregando fase" */
  .fx { display: grid; place-items: center; background: var(--color-fliperama); }
  .fx-load { display: grid; justify-items: center; gap: 10px; text-align: center; }
  .fx.out { animation: fx-blink-out 0.12s steps(2) forwards; }
  @keyframes fx-blink-out { 50% { opacity: 0.4; } to { opacity: 0; } }
  .fx-load-k { margin: 0; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-ficha); }
  .fx-load-name { margin: 0; font-size: clamp(36px, 7vw, 64px); line-height: 1; }
  .fx-load-bar { width: min(320px, 70vw); height: 18px; padding: 3px; margin-top: 10px; background: var(--color-grade); }
  .fx-load-bar span {
    display: block;
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, #ff5fa2 0 16.6%, #d15dda 16.6% 33.3%, #a162ff 33.3% 50%, #6d76ff 50% 66.6%, #4da0ff 66.6% 83.3%, #38d6ff 83.3%);
  }
  .fx .fx-load-bar span { animation: fx-fill 0.42s steps(6) both; }
  @keyframes fx-fill { from { width: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .cover[data-state="starting"] .press-start {
      animation: none;
    }
  }
</style>

<script>
  const cover = document.getElementById("cover")!;
  const button = document.getElementById("press-start") as HTMLButtonElement;
  const menu = document.getElementById("menu")!;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const phases = [...document.querySelectorAll<HTMLElement>("[data-phase]")];
  const bars = [...menu.querySelectorAll<HTMLAnchorElement>(".mbar")];

  // ── Seleção do menu: um único estado ──
  // Mouse, toque, Tab e setas passam todos por select(), que liga .is-selected
  // em uma barra e desliga nas outras. Nunca há duas selecionadas.
  let selected = Math.max(0, bars.findIndex((b) => b.classList.contains("is-selected")));

  function select(i: number, focus = false) {
    selected = (i + bars.length) % bars.length;
    bars.forEach((b, j) => {
      const on = j === selected;
      // Religar a classe reinicia a animação da barra de vida
      if (on && !b.classList.contains("is-selected")) b.classList.add("is-selected");
      if (!on) b.classList.remove("is-selected");
    });
    if (focus) bars[selected].focus({ preventScroll: true });
  }

  bars.forEach((bar, i) => {
    bar.addEventListener("mouseenter", () => select(i, true));
    bar.addEventListener("focus", () => select(i));
  });

  // Setas só quando o menu está visível na tela e o foco não está dentro de uma fase
  document.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
    if (menu.hidden || menu.getBoundingClientRect().bottom < 0) return;
    if ((document.activeElement as Element | null)?.closest("[data-phase]")) return;
    e.preventDefault();
    select(selected + (e.key === "ArrowDown" ? 1 : -1), true);
  });

  // O hash é a fonte da verdade:
  //   ""          → capa (PRESS START)
  //   #menu       → menu, tudo trancado
  //   #<id>       → menu + destrava a fase que contém o elemento #<id> e rola até ele
  // Assim links diretos (/#jogador, /#contato) e o "voltar" do navegador funcionam.

  function showMenu() {
    cover.dataset.state = "menu";
    menu.hidden = false;
  }

  function lockAll() {
    phases.forEach((p) => (p.hidden = true));
  }

  // Cada navegação incrementa o contador; um trancamento pendente (esperando a
  // rolagem terminar) só vale se nenhuma navegação nova aconteceu nesse meio-tempo.
  let navToken = 0;

  // Sobe até o topo (suave, se permitido) e só então tranca, para não "pular".
  function scrollTopThenLock() {
    const my = navToken;
    if (window.scrollY === 0 || reduced) {
      // "instant" explícito: o html tem scroll-behavior: smooth no CSS
      window.scrollTo({ top: 0, behavior: "instant" });
      lockAll();
      return;
    }
    let done = false;
    const finish = () => {
      if (done || my !== navToken) return;
      done = true;
      lockAll();
    };
    window.addEventListener("scrollend", finish, { once: true });
    setTimeout(finish, 900); // navegadores sem scrollend
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  // ── Transição ao entrar numa fase ──
  // Só quando a pessoa entra numa fase que estava trancada (não em link direto
  // nem com reduced-motion). O conteúdo troca "por trás" do efeito, no meio dele.
  const fx = document.getElementById("fx")!;
  const fxName = fx.querySelector<HTMLElement>("[data-fx-name]")!;
  const NAMES: Record<string, string> = { jogador: "Jogador", portfolio: "Portfólio", nekobit: "Nekobit" };

  function playFx(phaseId: string, mid: () => void) {
    fx.classList.remove("out");
    fxName.textContent = NAMES[phaseId] ?? phaseId;
    // Reinicia a animação da barra a cada entrada
    const bar = fx.querySelector<HTMLElement>(".fx-load-bar span");
    if (bar) {
      bar.style.animation = "none";
      void bar.offsetWidth;
      bar.style.animation = "";
    }
    fx.hidden = false;
    setTimeout(() => {
      mid();
      fx.classList.add("out");
    }, 480);
    setTimeout(() => (fx.hidden = true), 620);
  }

  function route(instant = false) {
    navToken++;
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) {
      cover.dataset.state = "start";
      menu.hidden = true;
      lockAll();
      return;
    }
    showMenu();
    if (id === "menu") {
      scrollTopThenLock();
      return;
    }
    const target = document.getElementById(id);
    const phase = target?.closest<HTMLElement>("[data-phase]");
    if (!target || !phase) return;
    const entering = phase.hidden;
    const reveal = (behavior: ScrollBehavior) => {
      phases.forEach((p) => (p.hidden = p !== phase));
      // Ao voltar ao menu, a barra da última fase aberta continua selecionada
      const bar = bars.findIndex((b) => b.getAttribute("href") === `#${phase.id}`);
      if (bar >= 0) select(bar);
      target.scrollIntoView({ behavior });
    };
    if (entering && !instant && !reduced) {
      playFx(phase.id, () => reveal("instant"));
    } else {
      reveal(instant || reduced ? "instant" : "smooth");
    }
  }

  function start() {
    if (cover.dataset.state !== "start") return;
    const go = () => {
      location.hash = "menu";
      select(selected, true);
    };
    if (reduced) return go();
    cover.dataset.state = "starting";
    setTimeout(go, 600);
  }

  button.addEventListener("click", start);
  // Enter/Espaço em qualquer lugar da capa também dão start
  document.addEventListener("keydown", (e) => {
    if (cover.dataset.state === "start" && (e.key === "Enter" || e.key === " ")) {
      e.preventDefault();
      start();
    }
  });

  window.addEventListener("hashchange", () => route());
  // Clicar num link para o hash atual não dispara hashchange: roteia mesmo assim.
  document.addEventListener("click", (e) => {
    const a = (e.target as Element).closest?.("a[href^='#']");
    if (a && a.getAttribute("href") === location.hash) {
      e.preventDefault();
      route();
    }
  });
  route(true);
</script>
